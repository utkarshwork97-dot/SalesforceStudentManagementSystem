<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_future_Attendance</fullName>
    <active>true</active>
    <errorConditionFormula>Attendance_Date__c &gt; TODAY()</errorConditionFormula>
    <errorMessage>Attendance cannot be marked for a future date.</errorMessage>
</ValidationRule>
